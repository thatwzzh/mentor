# Nacos
# API服务地址，供宿主机上的 agent 访问
NACOS_SERVER_ADDRESS = ""
# 沙箱内访问 Nacos 的地址
NACOS_SERVER_ADDRESS_IN_SANDBOX = "http://host.docker.internal:8848"
# 命名空间
NACOS_NAMESPACE_ID = ""
# 用户名
NACOS_USERNAME = ""
# 用户密码
NACOS_PASSWORD = ""
# TTL: Nacos服务端资源在本地缓存的时间，单位秒
NACOS_TTL = 5
# AgentSpec 发布标签：production / staging
NACOS_LABEL = production

# MinIO
MINIO_ACCESS_KEY = ""
MINIO_SECRET_KEY = ""
MINIO_ENDPOINT = "localhost:9002"
MINIO_SECURE = false
# 沙箱内上传地址
MINIO_ENDPOINT_IN_SANDBOX = "host.docker.internal:9002"
# 产物桶名
MINIO_BUCKET = "agent-artifacts"
# 产物预签名 URL 有效期（秒），1 秒至 7 天
MINIO_PRESIGN_EXPIRE_SECONDS = 3600

# OpenAI API 百炼
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mentor

# TAVILY
TAVILY_API_KEY=

# langfuse
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""
# 定期清理 Trace 的保留天数；不配置时清理函数拒绝执行
LANGFUSE_TRACE_RETENTION_DAYS=14
# 实验 Webhook 独立签名密钥；留空时拒绝请求（503）
LANGFUSE_EXPERIMENT_WEBHOOK_SECRET=""
# Alert Automation 的独立 Webhook 签名密钥；留空时拒绝请求（503）
LANGFUSE_ALERT_WEBHOOK_SECRET="" 

# benchmark
BENCHMARK_AGENT_SERVER="http://localhost/"
BENCHMARK_USER_ID="test_user" 
BENCHMARK_GRAPH_ID="main_agent"


# 以下配置仅用于基础设施启动的环境变量

# ------langfuse-----

LANGFUSE_WEBHOOK_WHITELISTED_HOST=host.docker.internal

# [可选]Langfuse 事务邮件
LANGFUSE_SMTP_CONNECTION_URL=
LANGFUSE_EMAIL_FROM_ADDRESS=

# [可选]Langfuse Ask AI（复用文件上方的 OpenAI 兼容模型配置）
LANGFUSE_OPENAI_API_KEY=${OPENAI_API_KEY}
LANGFUSE_OPENAI_BASE_URL=${OPENAI_BASE_URL}
LANGFUSE_OPENAI_DEFAULT_MODEL=${OPENAI_DEFAULT_MODEL}

# 工具超长输出落盘目录；默认 /tmp/mentor-tool-artifacts
TOOL_ARTIFACT_DIR=/tmp/mentor-tool-artifacts
# 是否把超长工具全文镜像到 MinIO（需 MINIO_ACCESS_KEY/SECRET_KEY）
TOOL_MINIO_ARTIFACTS=true

# 会话投影事件表（Postgres；对应 docker-compose 的 mentor-postgres）
MENTOR_POSTGRES_PASSWORD=mentor
RUN_EVENTS_DSN=postgresql://mentor:mentor@127.0.0.1:5433/mentor
RUN_EVENTS_KEEP_LAST_TURNS=10
RUN_EVENTS_MAX_TOOL_CHARS=500
RUN_EVENTS_SUMMARY_MAX_CHARS=4000
# Postgres 写入失败时的事件 outbox；用 mentor events replay 重放
RUN_EVENTS_OUTBOX_DIR=/tmp/mentor-run-events-outbox

# 工具策略：allow / prompt / deny；设为 false 可整体回退
TOOL_POLICY_FILE=config/tool_policy.yaml
TOOL_POLICY_ENABLED=true

# 上下文压缩：显式 trigger/keep；auto_compact=false 时只保留 /compact 手动触发
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_TRIGGER_RATIO=0.8
CONTEXT_PRECOMPACT_RATIO=0.60
CONTEXT_KEEP_MESSAGES=20
CONTEXT_TRIM_TOKENS_TO_SUMMARIZE=4000
CONTEXT_AUTO_COMPACT=true

# 模型请求边界：LiteLLM 负责 provider 重试/fallback/熔断，Agent 侧默认不重复重试
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=0

# 单 run 预算；0 表示不限制
RUN_BUDGET_MAX_TOKENS=0
RUN_BUDGET_MAX_SECONDS=0
RUN_BUDGET_MAX_OUTPUT_TOKENS=4096

# OpenSandbox Server API 密钥（在实际 .env 中填写随机值，不要提交真实密钥）
OPEN_SANDBOX_DOMAIN=127.0.0.1:8090
OPEN_SANDBOX_API_KEY=change-me
# PVC 名称前缀；最终 PVC 为 <tenant>-<sha256(user_id)[:12]>
OPEN_SANDBOX_TENANT=default
# 仅本地脚本/测试可设为 true；生产禁止 InMemoryStore 回落
OPEN_SANDBOX_ALLOW_MEMORY_STORE=false
# 进程内空闲沙箱回收时间（秒），0 表示交给 OpenSandbox TTL
OPEN_SANDBOX_IDLE_TIMEOUT_SECONDS=1800
